<Window x:Class="SminexBimTools.UI.ParameterPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры проекта"
        Width="540"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#FF606060"
                   Margin="0,0,0,8"
                   Text="Проектные и общие параметры документа. Выберите один или несколько (Ctrl/Shift) и нажмите «Добавить»."/>

        <TextBox x:Name="FilterBox"
                 Grid.Row="1"
                 Margin="0,0,0,8"
                 Padding="4,3"
                 TextChanged="FilterBox_TextChanged"/>

        <ListView x:Name="ParamsList"
                  Grid.Row="2"
                  SelectionMode="Extended"
                  MouseDoubleClick="ParamsList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Имя" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Тип данных" Width="150" DisplayMemberBinding="{Binding DataTypeLabel}"/>
                    <GridViewColumn Header="Вид" Width="90" DisplayMemberBinding="{Binding KindLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Добавить"
                    Padding="18,5"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Add_Click"/>
            <Button Content="Отмена"
                    Padding="18,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
