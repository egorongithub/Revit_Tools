<Window x:Class="SminexBimTools.UI.SelectElementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sminex BIM Tools — выбор элементов"
        Width="540"
        Height="560"
        MinWidth="440"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#FF606060"
                   Margin="0,0,0,10"
                   Text="Отметьте группы — входящие в них элементы будут выделены в модели (объединение отмеченных групп)."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Выделить"
                    Padding="18,5"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Select_Click"/>
            <Button Content="Отмена"
                    Padding="18,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
