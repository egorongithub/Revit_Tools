<Window x:Class="SminexBimTools.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sminex BIM Tools — настройки"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Foreground="#FF606060"
                   Margin="0,0,0,10"
                   Text="Правила проверяются сверху вниз — используется первый найденный параметр со значением. Источник «Авто» ищется по общему порядку поиска; явный источник («Экземпляр»/«Тип») — только на своем шаге."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить" Padding="10,3" Margin="0,0,6,0" Click="Add_Click"/>
            <Button Content="Удалить" Padding="10,3" Margin="0,0,6,0" Click="Remove_Click"/>
            <Button Content="▲" Padding="8,3" Margin="0,0,3,0" Click="RuleUp_Click"/>
            <Button Content="▼" Padding="8,3" Margin="0,0,12,0" Click="RuleDown_Click"/>
            <Button x:Name="PickButton" Content="Выбрать из проекта…" Padding="10,3" Margin="0,0,6,0" Click="Pick_Click"/>
            <Button x:Name="AnalyzeButton" Content="Проверить в модели" Padding="10,3" Click="Analyze_Click"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Height="230">
            <TabItem Header="Объем">
                <DataGrid x:Name="VolumeGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="300"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Площадь">
                <DataGrid x:Name="AreaGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="300"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Длина">
                <DataGrid x:Name="LengthGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="300"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock TextWrapping="Wrap"
                   Foreground="#FF909090"
                   FontSize="11.5"
                   Margin="0,4,0,0"
                   Text="Статусы: ✓ подходит; • найден, но без размерности (значение берется как есть); ✗ недопустимый тип данных; — не найден. Проверяются проектные и общие параметры документа; параметры, определенные внутри семейств, проверке недоступны, но при подсчете читаются."/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Порядок поиска (для «Авто»)" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="OrderList" Width="150" Height="76"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Content="▲" Padding="8,3" Margin="0,0,0,6" Click="OrderUp_Click"/>
                        <Button Content="▼" Padding="8,3" Click="OrderDown_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                <CheckBox x:Name="RoundUpCheck"
                          Content="Округлять последнюю цифру вверх, как в Revit (0,8325 → 0,833)"
                          Margin="0,2,0,0"/>
                <CheckBox x:Name="GroupCategoryCheck"
                          Content="В результатах: разбивка по категориям"
                          Margin="0,8,0,0"/>
                <CheckBox x:Name="GroupParameterCheck"
                          Content="В результатах: разбивка по параметрам-источникам"
                          Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Знаков после запятой:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DecimalsCombo" Width="64" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Margin="0,18,0,0">
            <Button Content="По умолчанию"
                    HorizontalAlignment="Left"
                    Padding="14,5"
                    Click="Defaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Padding="18,5"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Padding="18,5"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
