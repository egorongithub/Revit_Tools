<Window x:Class="SminexBimTools.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sminex BIM Tools — настройки"
        Width="880"
        Height="760"
        MinWidth="780"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,6,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#FF606060"
                   Margin="0,0,0,10"
                   Text="Правила проверяются сверху вниз — используется первый найденный параметр со значением. В общих правилах источник «Авто» ищется по общему порядку поиска, явный источник — только на своем шаге. Если для категории элемента заданы исключения, используются ТОЛЬКО они: строки общих правил и системный параметр Revit к таким элементам не применяются, а правила исключений проверяются строго сверху вниз. Вид параметра не важен — ищется любой параметр с таким именем (системный, общий, проекта или семейства) в месте, заданном колонкой «Источник». «Размерность» применяется к безразмерным числовым значениям: они трактуются в выбранной единице и переводятся в метрические; «Авто» — берется как есть."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Добавить" Padding="10,3" Margin="0,0,6,0" Click="Add_Click"/>
            <Button Content="Удалить" Padding="10,3" Margin="0,0,6,0" Click="Remove_Click"/>
            <Button Content="▲" Padding="8,3" Margin="0,0,3,0" Click="RuleUp_Click"/>
            <Button Content="▼" Padding="8,3" Margin="0,0,12,0" Click="RuleDown_Click"/>
            <Button x:Name="PickButton" Content="Выбрать из проекта…" Padding="10,3" Margin="0,0,6,0" Click="Pick_Click"/>
            <Button x:Name="AnalyzeButton" Content="Проверить в модели" Padding="10,3" Click="Analyze_Click"/>
            <TextBlock Text="Кнопки действуют на таблицу, в которой выбрана строка."
                       Foreground="#FF909090" FontSize="11.5"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2">
            <TabItem Header="Объем">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Общие правила (для всех категорий)"/>
                    <DataGrid x:Name="VolumeGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Исключения по категориям (только эти правила, без общих и без системного параметра)"/>
                    <DataGrid x:Name="VolumeCategoryGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Площадь">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Общие правила (для всех категорий)"/>
                    <DataGrid x:Name="AreaGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Исключения по категориям (только эти правила, без общих и без системного параметра)"/>
                    <DataGrid x:Name="AreaCategoryGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Длина">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Общие правила (для всех категорий)"/>
                    <DataGrid x:Name="LengthGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Исключения по категориям (только эти правила, без общих и без системного параметра)"/>
                    <DataGrid x:Name="LengthCategoryGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Масса">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Общие правила (для всех категорий)"/>
                    <DataGrid x:Name="MassGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionHeader}" Text="Исключения по категориям (только эти правила, без общих и без системного параметра)"/>
                    <DataGrid x:Name="MassCategoryGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3"
                   TextWrapping="Wrap"
                   Foreground="#FF909090"
                   FontSize="11.5"
                   Margin="0,4,0,0"
                   Text="Статусы: ✓ подходит; • найден, но без размерности (значение берется как есть или в заданной размерности); ✗ недопустимый тип данных; — не найден. Проверяются проектные и общие параметры документа; параметры, определенные внутри семейств, проверке недоступны, но при подсчете читаются."/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Порядок поиска (для «Авто»)" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="OrderList" Width="150" Height="76"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Content="▲" Padding="8,3" Margin="0,0,0,6" Click="OrderUp_Click"/>
                        <Button Content="▼" Padding="8,3" Click="OrderDown_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                <CheckBox x:Name="RoundUpCheck"
                          Content="Округлять последнюю цифру вверх, как в Revit (0,8325 → 0,833)"
                          Margin="0,2,0,0"/>
                <CheckBox x:Name="GroupCategoryCheck"
                          Content="В результатах: разбивка по категориям"
                          Margin="0,8,0,0"/>
                <CheckBox x:Name="GroupParameterCheck"
                          Content="В результатах: разбивка по параметрам-источникам"
                          Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Знаков после запятой:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DecimalsCombo" Width="64" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Button Content="По умолчанию"
                    HorizontalAlignment="Left"
                    Padding="14,5"
                    Click="Defaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Padding="18,5"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Padding="18,5"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
