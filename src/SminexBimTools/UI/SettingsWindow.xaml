<Window x:Class="SminexBimTools.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sminex BIM Tools — настройки"
        Width="880"
        Height="720"
        MinWidth="780"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF909090"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="2,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button x:Name="InfoButton"
                    DockPanel.Dock="Right"
                    Content="ⓘ"
                    Width="28"
                    Height="26"
                    FontSize="15"
                    ToolTipService.ShowDuration="60000"
                    Click="Info_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AnalyzeButton" Content="Проверить в модели" Padding="10,3" Click="Analyze_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem Header="Объем">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,6,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="VolumePickButton" Content="Из проекта…" Tag="Volume" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="Volume" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="Volume" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="Volume" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="Volume" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Общие правила" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="VolumeGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource LegendText}"
                               Text="Статусы: ✓ подходит · • найден, но без размерности · ✗ не подходит тип данных · — не найден"/>

                    <DockPanel Grid.Row="3" Margin="0,10,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="VolumeCatPickButton" Content="Из проекта…" Tag="VolumeCategory" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="VolumeCategory" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="VolumeCategory" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="VolumeCategory" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="VolumeCategory" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Исключения по категориям" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="VolumeCategoryGrid" Grid.Row="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Площадь">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,6,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="AreaPickButton" Content="Из проекта…" Tag="Area" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="Area" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="Area" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="Area" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="Area" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Общие правила" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="AreaGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource LegendText}"
                               Text="Статусы: ✓ подходит · • найден, но без размерности · ✗ не подходит тип данных · — не найден"/>

                    <DockPanel Grid.Row="3" Margin="0,10,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="AreaCatPickButton" Content="Из проекта…" Tag="AreaCategory" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="AreaCategory" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="AreaCategory" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="AreaCategory" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="AreaCategory" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Исключения по категориям" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="AreaCategoryGrid" Grid.Row="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Длина">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,6,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="LengthPickButton" Content="Из проекта…" Tag="Length" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="Length" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="Length" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="Length" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="Length" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Общие правила" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="LengthGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource LegendText}"
                               Text="Статусы: ✓ подходит · • найден, но без размерности · ✗ не подходит тип данных · — не найден"/>

                    <DockPanel Grid.Row="3" Margin="0,10,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="LengthCatPickButton" Content="Из проекта…" Tag="LengthCategory" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="LengthCategory" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="LengthCategory" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="LengthCategory" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="LengthCategory" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Исключения по категориям" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="LengthCategoryGrid" Grid.Row="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Масса">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,6,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="MassPickButton" Content="Из проекта…" Tag="Mass" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="Mass" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="Mass" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="Mass" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="Mass" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Общие правила" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="MassGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource LegendText}"
                               Text="Статусы: ✓ подходит · • найден, но без размерности · ✗ не подходит тип данных · — не найден"/>

                    <DockPanel Grid.Row="3" Margin="0,10,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="MassCatPickButton" Content="Из проекта…" Tag="MassCategory" Style="{StaticResource MiniButton}" Click="SectionPick_Click"/>
                            <Button Content="Добавить" Tag="MassCategory" Style="{StaticResource MiniButton}" Click="SectionAdd_Click"/>
                            <Button Content="Удалить" Tag="MassCategory" Style="{StaticResource MiniButton}" Click="SectionRemove_Click"/>
                            <Button Content="▲" Tag="MassCategory" Style="{StaticResource MiniButton}" Click="SectionUp_Click"/>
                            <Button Content="▼" Tag="MassCategory" Style="{StaticResource MiniButton}" Click="SectionDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Исключения по категориям" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="MassCategoryGrid" Grid.Row="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridComboBoxColumn Header="Источник" SelectedItemBinding="{Binding SourceLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridComboBoxColumn Header="Размерность" SelectedItemBinding="{Binding UnitLabel, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Статус в модели" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Порядок поиска (для «Авто»)" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="OrderList" Width="150" Height="76"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Content="▲" Padding="8,3" Margin="0,0,0,6" Click="OrderUp_Click"/>
                        <Button Content="▼" Padding="8,3" Click="OrderDown_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                <CheckBox x:Name="RoundUpCheck"
                          Content="Округлять последнюю цифру вверх, как в Revit (0,8325 → 0,833)"
                          Margin="0,2,0,0"/>
                <CheckBox x:Name="GroupCategoryCheck"
                          Content="В результатах: разбивка по категориям"
                          Margin="0,8,0,0"/>
                <CheckBox x:Name="GroupParameterCheck"
                          Content="В результатах: разбивка по параметрам-источникам"
                          Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Знаков после запятой:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DecimalsCombo" Width="64" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="По умолчанию"
                    HorizontalAlignment="Left"
                    Padding="14,5"
                    Click="Defaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Padding="18,5"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Padding="18,5"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
